# Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase Dashboard > Project Settings > API > Publishable (or anon) key.
# Required by the Google administrator sign-in flow.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase Dashboard > Project Settings > API > service_role. Nunca uses la publishable aquí.
SUPABASE_SERVICE_ROLE_KEY=
# Genera con: openssl rand -base64 48. Nunca cambies este valor sin cerrar las sesiones existentes.
AUTH_SESSION_SECRET=
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Llave de navegador con Maps JavaScript API y Places API habilitadas.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Llave privada de Wompi (priv_test_/priv_prod_) usada solamente por el cron.
WOMPI_PRIVATE_KEY=
# Secreto largo compartido por Vercel Cron y /api/cron/reconcile-orders.
CRON_SECRET=
